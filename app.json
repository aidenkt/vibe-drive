{
  "expo": {
    "name": "Scenic Route",
    "slug": "scenic-route",
    "scheme": "vibedrive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vibedrive.app",
      "icon": "./assets/brand/icon-1024.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/brand/icon-1024.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Scenic Route starts scenic routes from where you are."
        }
      ]
    ],
    "splash": {
      "image": "./assets/brand/icon-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#14110F"
    }
  }
}
